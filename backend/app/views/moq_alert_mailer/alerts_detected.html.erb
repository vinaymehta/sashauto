<div>
  <h1 style="font-size:20px;font-weight:700;margin:0 0 4px;color:#1d2636;">Below MOQ</h1>
  <p style="margin:0 0 16px;color:#737373;">
    <%= @batch.original_filename %> · uploaded by <%= @batch.uploaded_by.name %> on <%= @batch.completed_at.in_time_zone.strftime("%-d %b %Y, %H:%M IST") %>
  </p>
  <p style="margin:0 0 12px;color:#171717;">
    <strong><%= @total %></strong> part<%= "s" unless @total == 1 %> still to order below the MOQ: Balance to ORDER = Firm Qty less the Qty already on vendor POs.
  </p>
  <% th = "padding:8px 10px;font-weight:600;border:1px solid #d4d4d4;" %>
  <% td = "padding:7px 10px;color:#171717;border:1px solid #e5e5e5;" %>
  <table cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:13px;">
    <thead>
      <tr style="text-align:left;color:#404040;background:#fafafa;">
        <th style="<%= th %>">S No.</th>
        <th style="<%= th %>">Part Number</th>
        <th style="<%= th %>">Description</th>
        <th style="<%= th %>">SASH Part</th>
        <th style="<%= th %>text-align:right;">Firm</th>
        <th style="<%= th %>text-align:right;">MOQ</th>
        <th style="<%= th %>text-align:right;">John Deere Received Qty</th>
        <th style="<%= th %>text-align:right;">PO issued Qty against Firm Orders</th>
        <th style="<%= th %>text-align:right;background:#fff59d;">Balance to ORDER</th>
        <th style="<%= th %>">Remarks</th>
      </tr>
    </thead>
    <tbody>
      <% @alerts.each_with_index do |alert, i| %>
        <tr>
          <td style="<%= td %>"><%= i + 1 %></td>
          <td style="<%= td %>white-space:nowrap;"><%= alert.part_number %></td>
          <td style="<%= td %>"><%= alert.description || alert.product&.description %></td>
          <td style="<%= td %>white-space:nowrap;"><%= alert.sash_part || alert.product&.sash_part %></td>
          <td style="<%= td %>text-align:right;"><%= format_qty(alert.firm_qty || alert.qty) %></td>
          <td style="<%= td %>text-align:right;"><%= format_qty(alert.moq) %></td>
          <td style="<%= td %>text-align:right;"><%= alert.received_qty && format_qty(alert.received_qty) %></td>
          <td style="<%= td %>text-align:right;"><%= alert.po_issued_qty && format_qty(alert.po_issued_qty) %></td>
          <td style="<%= td %>text-align:right;font-weight:700;background:#fffbcc;"><%= format_qty(alert.qty) %></td>
          <td style="<%= td %>white-space:nowrap;">Need MOQ</td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @total > @alerts.size %>
    <p style="margin:12px 0 0;color:#737373;">Showing the first <%= @alerts.size %> of <%= @total %> MOQ alerts.</p>
  <% end %>
  <p style="margin:24px 0 0;"><a href="<%= @url %>" style="display:inline-block;background:#1d2636;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-weight:600;">View MOQ alerts in the dashboard</a></p>
</div>
