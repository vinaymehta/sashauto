<div style="max-width:760px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px;padding:24px;">
  <h1 style="font-size:20px;font-weight:600;margin:0 0 4px;color:#171717;">Address changes detected</h1>
  <p style="margin:0 0 16px;color:#737373;">
    <%= @batch.original_filename %> · uploaded by <%= @batch.uploaded_by.name %> on <%= @batch.completed_at.utc.strftime("%-d %b %Y, %H:%M UTC") %>
  </p>
  <p style="margin:0 0 12px;color:#171717;">
    <strong><%= @total %></strong> existing order row<%= "s" unless @total == 1 %> changed Ship To Address compared with the previous upload.
  </p>
  <table cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:13px;">
    <thead>
      <tr style="text-align:left;color:#404040;background:#fafafa;border-bottom:1px solid #e5e5e5;">
        <th style="padding:8px 10px;font-weight:600;">PO Number</th>
        <th style="padding:8px 10px;font-weight:600;">Part Number</th>
        <th style="padding:8px 10px;font-weight:600;">Ship Date</th>
        <th style="padding:8px 10px;font-weight:600;">Old Address</th>
        <th style="padding:8px 10px;font-weight:600;">New Address</th>
      </tr>
    </thead>
    <tbody>
      <% @changes.each do |change| %>
        <tr style="border-bottom:1px solid #f5f5f5;">
          <td style="padding:8px 10px;color:#171717;"><%= change.po_number %></td>
          <td style="padding:8px 10px;color:#171717;"><%= change.part_number %></td>
          <td style="padding:8px 10px;color:#171717;white-space:nowrap;"><%= change.ship_date.strftime("%-d %b %Y") %></td>
          <td style="padding:8px 10px;color:#737373;text-decoration:line-through;"><%= change.old_address.presence || "—" %></td>
          <td style="padding:8px 10px;color:#171717;font-weight:600;"><%= change.new_address.presence || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @total > @changes.size %>
    <p style="margin:12px 0 0;color:#737373;">Showing the first <%= @changes.size %> of <%= @total %> address changes.</p>
  <% end %>
  <p style="margin:20px 0 0;"><a href="<%= @url %>" style="color:#171717;">View all changes in the dashboard</a></p>
</div>
