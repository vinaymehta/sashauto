<% @email_width = 600 %>
<div>
  <h1 style="font-size:20px;font-weight:700;margin:0 0 4px;color:#1d2636;"><%= @delivery.kind == "inbound" ? "Inbound" : "Outbound" %>: <%= @delivery.label %></h1>
  <p style="margin:0 0 20px;color:#737373;">
    Marked by <%= @delivery.marked_by.name %> on <%= @delivery.created_at.utc.strftime("%-d %b %Y, %H:%M UTC") %>.
  </p>
  <table cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:14px;">
    <% [ [ "PO Number", @delivery.po_number ], [ "PO Line Number", @delivery.po_line_number ], [ "Part Number", @delivery.part_number ],
         [ "Type", @delivery.order_type ], [ "Ship Date", @delivery.ship_date.strftime("%-d %b %Y") ],
         [ "Delivered on", @delivery.delivered_on.strftime("%-d %b %Y") ], [ "Note", @delivery.note ] ].each do |label, value| %>
      <tr style="border-bottom:1px solid #f0f0f0;">
        <td style="padding:9px 10px;color:#737373;width:160px;"><%= label %></td>
        <td style="padding:9px 10px;color:#171717;"><%= value.presence || "—" %></td>
      </tr>
    <% end %>
  </table>
  <p style="margin:24px 0 0;"><a href="<%= @url %>" style="display:inline-block;background:#1d2636;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-weight:600;">Open the Orders page</a></p>
</div>
