<div>
  <h1 style="font-size:20px;font-weight:700;margin:0 0 4px;color:#1d2636;">Different Ship To</h1>
  <p style="margin:0 0 16px;color:#737373;">
    <%= @batch.original_filename %> · uploaded by <%= @batch.uploaded_by.name %> on <%= @batch.completed_at.in_time_zone.strftime("%-d %b %Y, %H:%M IST") %>
  </p>
  <p style="margin:0 0 16px;color:#171717;">
    <strong><%= @total %></strong> order row<%= "s" unless @total == 1 %> ship<%= "s" if @total == 1 %> to an address other than the default
    <strong><%= @default %></strong>.
  </p>
  <table cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:13px;">
    <thead>
      <tr style="text-align:left;color:#404040;background:#fafafa;border-bottom:1px solid #e5e5e5;">
        <th style="padding:8px 10px;font-weight:600;">PO Number</th>
        <th style="padding:8px 10px;font-weight:600;">PO Line</th>
        <th style="padding:8px 10px;font-weight:600;">Part Number</th>
        <th style="padding:8px 10px;font-weight:600;">Type</th>
        <th style="padding:8px 10px;font-weight:600;">Ship Date</th>
        <th style="padding:8px 10px;font-weight:600;">Ship To</th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <tr style="border-bottom:1px solid #f5f5f5;">
          <td style="padding:8px 10px;color:#171717;"><%= row.po_number %></td>
          <td style="padding:8px 10px;color:#171717;"><%= row.po_line_number %></td>
          <td style="padding:8px 10px;color:#171717;"><%= row.part_number %></td>
          <td style="padding:8px 10px;color:#171717;"><%= row.order_type %></td>
          <td style="padding:8px 10px;color:#171717;white-space:nowrap;"><%= row.ship_date.strftime("%-d %b %Y") %></td>
          <td style="padding:8px 10px;color:#8a5a00;font-weight:600;"><%= Orders::ShipTo.address(row.source_data) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @total > @rows.size %>
    <p style="margin:12px 0 0;color:#737373;">Showing the first <%= @rows.size %> of <%= @total %> rows.</p>
  <% end %>
  <p style="margin:24px 0 0;"><a href="<%= @url %>" style="display:inline-block;background:#1d2636;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-weight:600;">Open the Orders page</a></p>
</div>
