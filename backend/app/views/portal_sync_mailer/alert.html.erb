<div>
  <h1 style="font-size:20px;font-weight:700;margin:0 0 4px;color:#1d2636;"><%= @title %></h1>
  <p style="margin:0 0 16px;color:#737373;"><%= @at.strftime("%-d %b %Y, %H:%M IST") %></p>
  <% if @kind == "otp_needed" %>
    <p style="margin:0 0 12px;color:#171717;">
      The Deere portal sent an SMS code. The sync is waiting for it<% if @expires_at %> until <strong><%= @expires_at.strftime("%H:%M IST") %></strong><% end %>.
      Open the app and enter the code in the John Deere sync popup.
    </p>
  <% end %>
  <% @message.each_line do |line| %>
    <p style="margin:0 0 8px;color:<%= @kind == "otp_needed" ? "#404040" : "#a8321f" %>;"><%= line.strip %></p>
  <% end %>
  <p style="margin:24px 0 0;"><a href="<%= @url %>" style="display:inline-block;background:#1d2636;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-weight:600;"><%= @kind == "otp_needed" ? "Enter the OTP" : "Open the John Deere sync" %></a></p>
</div>
