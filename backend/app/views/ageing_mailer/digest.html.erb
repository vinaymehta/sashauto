<div style="max-width:760px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px;padding:24px;">
  <h1 style="font-size:20px;font-weight:600;margin:0 0 4px;color:#171717;">Order ageing</h1>
  <p style="margin:0 0 20px;color:#737373;">
    <%= @digest.row_count %> order row<%= "s" unless @digest.row_count == 1 %>
    (one per PO Number, Part Number and Type, latest ship date) are 30 or more days past their ship date as of <%= @today.strftime("%-d %b %Y") %>.
  </p>
  <% @bands.each do |threshold, rows| %>
    <% next if rows.empty? %>
    <% bg, ink = AgeingMailer::BAND_COLORS[threshold] %>
    <h2 style="font-size:15px;font-weight:600;margin:20px 0 8px;color:<%= ink %>;">
      <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:<%= ink %>;margin-right:6px;"></span>
      <%= AgeingMailer::BAND_TITLES[threshold] %> (<%= @digest.counts[threshold.to_s] || rows.size %>)
    </h2>
    <table cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead>
        <tr style="text-align:left;color:#404040;background:#fafafa;border-bottom:1px solid #e5e5e5;">
          <th style="padding:8px 10px;font-weight:600;">PO Number</th>
          <th style="padding:8px 10px;font-weight:600;">PO Line</th>
          <th style="padding:8px 10px;font-weight:600;">Part Number</th>
          <th style="padding:8px 10px;font-weight:600;">Type</th>
          <th style="padding:8px 10px;font-weight:600;">Ship Date</th>
          <th style="padding:8px 10px;font-weight:600;text-align:right;">Days</th>
          <th style="padding:8px 10px;font-weight:600;text-align:right;">Qty</th>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr style="background:<%= bg %>;border-bottom:1px solid #ffffff;">
            <td style="padding:8px 10px;color:#171717;"><%= row.po_number %></td>
            <td style="padding:8px 10px;color:#171717;"><%= row.po_line_number %></td>
            <td style="padding:8px 10px;color:#171717;"><%= row.part_number %></td>
            <td style="padding:8px 10px;color:#171717;"><%= row.order_type %></td>
            <td style="padding:8px 10px;color:#171717;white-space:nowrap;"><%= row.ship_date.strftime("%-d %b %Y") %></td>
            <td style="padding:8px 10px;text-align:right;font-weight:600;color:<%= ink %>;"><%= Ageing::Rules.days_since(row.ship_date, @today) %></td>
            <td style="padding:8px 10px;text-align:right;color:#171717;"><%= format_qty(row.effective_qty) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if (@digest.counts[threshold.to_s] || 0) > rows.size %>
      <p style="margin:8px 0 0;color:#737373;">Showing the first <%= rows.size %> of <%= @digest.counts[threshold.to_s] %> rows.</p>
    <% end %>
  <% end %>
  <p style="margin:20px 0 0;"><a href="<%= @url %>" style="color:#171717;">Open the Orders page</a></p>
</div>
