<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <%# Email-safe layout: nested tables and inline styles. Templates may set @email_width (default 760). %>
  <% width = @email_width || 760 %>
  <body style="margin:0;padding:0;background:#f4f5f7;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#171717;font-size:14px;line-height:1.5;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;">
      <tr>
        <td align="center" style="padding:32px 12px;">
          <table role="presentation" width="<%= width %>" cellpadding="0" cellspacing="0" style="width:100%;max-width:<%= width %>px;border-collapse:separate;">
            <tr>
              <td style="height:4px;line-height:4px;font-size:0;background:#0aa1c0;border-radius:8px 8px 0 0;">&nbsp;</td>
            </tr>
            <tr>
              <td style="background:#ffffff;padding:20px 32px;border-left:1px solid #e5e5e5;border-right:1px solid #e5e5e5;border-bottom:1px solid #eef0f3;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td><img src="<%= attachments["sash-logo.png"].url %>" width="128" height="30" alt="SASH" style="display:block;border:0;"></td>
                    <td align="right" style="color:#737373;font-size:12px;letter-spacing:0.06em;text-transform:uppercase;">Order Tracker</td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="background:#ffffff;padding:28px 32px 32px;border:1px solid #e5e5e5;border-top:0;border-radius:0 0 8px 8px;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:20px 12px 0;color:#a3a3a3;font-size:12px;">
                Sent by the SASH Order Tracker · &copy; <%= Date.current.year %> SASH
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
