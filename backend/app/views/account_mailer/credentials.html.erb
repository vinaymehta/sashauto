<div style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px;padding:24px;">
  <h1 style="font-size:20px;font-weight:600;margin:0 0 4px;color:#171717;">
    <%= @reset ? "Your password was reset" : "Welcome to the SASH portal" %>
  </h1>
  <p style="margin:0 0 20px;color:#737373;">
    Hello <%= @user.name %>, <%= @reset ? "an administrator set a new password for your account." : "an administrator created an account for you." %>
  </p>
  <table cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:14px;">
    <tr style="border-bottom:1px solid #f0f0f0;">
      <td style="padding:9px 10px;color:#737373;width:150px;">Sign-in page</td>
      <td style="padding:9px 10px;"><a href="<%= @login_url %>" style="color:#3b72e0;"><%= @login_url %></a></td>
    </tr>
    <tr style="border-bottom:1px solid #f0f0f0;">
      <td style="padding:9px 10px;color:#737373;">Email</td>
      <td style="padding:9px 10px;color:#171717;"><%= @user.email %></td>
    </tr>
    <tr style="border-bottom:1px solid #f0f0f0;">
      <td style="padding:9px 10px;color:#737373;">Temporary password</td>
      <td style="padding:9px 10px;color:#171717;font-weight:600;font-family:ui-monospace,Menlo,Consolas,monospace;"><%= @password %></td>
    </tr>
    <tr>
      <td style="padding:9px 10px;color:#737373;">Role</td>
      <td style="padding:9px 10px;color:#171717;"><%= @user.role == "admin" ? "Admin" : "Warehouse Manager" %></td>
    </tr>
  </table>
  <p style="margin:20px 0 0;color:#171717;">You will be asked to choose your own password the first time you sign in.</p>
  <p style="margin:8px 0 0;color:#737373;font-size:13px;">If you did not expect this email, contact your administrator.</p>
</div>
