# Backend (Rails API + Sidekiq) settings. Copy to backend/.env and fill in.
# Real environment variables (systemd, Docker, CI) always take precedence over this file.
# Values marked REQUIRED must be set in production, or the app refuses to start.

# --- Runtime -----------------------------------------------------------------
# Set RAILS_ENV=production in the server's environment (service / shell), not here: Rails picks the
# environment before this file is read.
# Port the Rails API (Puma) listens on. The frontend's BACKEND_URL must use the same port.
PORT=4000
# Puma threads (also the database connection pool size; keep >= Sidekiq concurrency, default 5).
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info
# Decrypts config/credentials.yml.enc (secret_key_base). REQUIRED in production.
RAILS_MASTER_KEY=

# --- Database and Redis (REQUIRED in production) ------------------------------
# PostgreSQL: postgres://USER:PASSWORD@HOST:5432/DATABASE  (default PostgreSQL port 5432)
DATABASE_URL=postgres://order_tracker:change-me@db.internal:5432/order_tracker_production
# Redis for Sidekiq: redis://HOST:6379/0  (default Redis port 6379; use a database number not shared with other apps)
REDIS_URL=redis://redis.internal:6379/0

# --- Public URL (REQUIRED in production) -------------------------------------
# The address users open in the browser (the Next.js frontend), used for links in emails.
# https://... turns on HTTPS redirect and secure cookies; use http://... only if the server has no TLS.
# Include the port if it is not 80/443, e.g. http://203.0.113.10:3000
APP_URL=https://orders.example.com

# --- Email --------------------------------------------------------------------
# Who receives the alert emails (comma-separated). Blank = every active Admin user.
ADMIN_NOTIFICATION_EMAILS=
# Emails are sent through Resend (https://resend.com). Both REQUIRED in production.
# RESEND_FROM is the sender and must be an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=alerts@example.com

# --- File storage -------------------------------------------------------------
# local = disk (STORAGE_ROOT must be a persistent, backed-up directory); amazon = S3-compatible (add aws-sdk-s3 gem)
ACTIVE_STORAGE_SERVICE=local
STORAGE_ROOT=/var/lib/order-tracker/storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
# Largest accepted upload in bytes (20971520 = 20 MB)
MAX_UPLOAD_BYTES=20971520

# --- Business settings --------------------------------------------------------
# Time zone used to count days past ship date in the ageing email (sent with each upload)
AGEING_TIME_ZONE=Asia/Kolkata

# --- First users (bin/rails db:seed) -----------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=
