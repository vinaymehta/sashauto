DATABASE_URL=postgres://user:password@localhost:5432/order_tracker_production
REDIS_URL=redis://localhost:6379/0
RAILS_MASTER_KEY=

# Public URL of the frontend (used in email links)
APP_URL=https://orders.example.internal
MAIL_FROM=order-tracker@example.internal
# Comma-separated. When blank, every active Admin user receives notifications.
ADMIN_NOTIFICATION_EMAILS=

SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain

# local (disk, must be a persistent backed-up volume) or amazon (S3-compatible; add aws-sdk-s3 gem)
ACTIVE_STORAGE_SERVICE=local
STORAGE_ROOT=/var/lib/order-tracker/storage
MAX_UPLOAD_BYTES=20971520

# Resend (https://resend.com). When set, emails are sent through the Resend API instead of SMTP.
# MAIL_FROM must be an address on a domain verified in Resend, e.g. alerts@yourcompany.com
RESEND_API_KEY=
# Sender used with Resend (must be on the verified domain)
RESEND_FROM=alerts@yourcompany.com

# Order ageing email: sent daily at 09:00 in this time zone (rows reaching 30/60/90 days past ship date)
AGEING_TIME_ZONE=Asia/Kolkata
