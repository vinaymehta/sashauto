# Frontend (Next.js) settings. Copy to frontend/.env and fill in.

# URL of the Rails API as reached FROM THIS SERVER (not from the browser). Use the backend's PORT (default 4000).
# Same machine: http://127.0.0.1:4000   Docker / other host: http://backend:4000
# REQUIRED for production, and it must be set BEFORE `npm run build` (the /api proxy is fixed at build time).
BACKEND_URL=http://127.0.0.1:4000

# Port Next.js listens on (default 3000). Next.js reads PORT from the shell / service environment, not from
# this file, so set it there if you need a different port, e.g.:  PORT=3000 npm run start
# PORT=3000

# Error tracking (Bugsnag) for the browser: the project's Notifier API key. Blank = off. Read at build time, so set it
# BEFORE `npm run build`. Only production builds report.
NEXT_PUBLIC_BUGSNAG_API_KEY=
